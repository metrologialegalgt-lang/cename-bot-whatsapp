# ============================================================
# Copia este archivo como .env y llena los valores reales
# ============================================================

# Puerto del servidor (Railway/Render lo asignan solos, localmente usa 3000)
PORT=3000

# Token de verificación del webhook — LO INVENTAS TÚ (cualquier cadena secreta).
# Debe coincidir con el que escribas en el panel de Meta al registrar el webhook.
VERIFY_TOKEN=mi-token-secreto-cambiar

# --- Meta / WhatsApp Cloud API ---
# Se obtienen en https://developers.facebook.com > tu app > WhatsApp > API Setup
# WHATSAPP_TOKEN: token de acceso (el temporal dura 24h; genera uno permanente
#   con un System User en Meta Business Suite para producción)
# PHONE_NUMBER_ID: el "Phone number ID" que aparece en API Setup (NO es el número)
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxx
PHONE_NUMBER_ID=123456789012345

# --- Proveedor de IA ---
# "gemini"    -> GRATIS, sin tarjeta. Límite de tokens amplio: elígelo si el prompt
#                del negocio es grande (tarifarios, catálogos extensos).
#                Key en https://aistudio.google.com/apikey
# "groq"      -> GRATIS, muy rápido, pero pocos tokens por día: solo para prompts pequeños.
#                Key en https://console.groq.com/keys
# "anthropic" -> de pago, mejor seguimiento de instrucciones (para producción exigente).
#                Key en https://console.anthropic.com
LLM_PROVIDER=gemini
GEMINI_API_KEY=AIza_xxxxxxxxxxxx
GROQ_API_KEY=gsk_xxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# Modelo (opcional; si lo dejas vacío usa el recomendado de cada proveedor:
# gemini -> gemini-2.5-flash | groq -> llama-3.3-70b-versatile | anthropic -> claude-haiku-4-5)
# LLM_MODEL=

# Qué negocio atiende esta instancia (nombre del archivo en /config sin .json)
BUSINESS_CONFIG=demo

# Número de WhatsApp del DUEÑO del negocio (código de país + número, solo dígitos).
# Recibe notificaciones de pedidos y avisos cuando un cliente pide humano.
# También puede enviar comandos al bot: "estado", "pausar NUMERO", "activar NUMERO".
# IMPORTANTE en fase de pruebas: este número debe estar agregado como
# destinatario de prueba en Meta (API Setup > "Para"), igual que el tuyo.
OWNER_PHONE=50212345678
